<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 深蓝渐变底（API 24+ 才会加载到这个版本）。
         adaptive icon 的形状由启动器自己裁剪，所以这里铺满整个 108x108，
         不留透明角，否则被裁成圆形时四个角会漏白。 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF3D7BFF"
                    android:offset="0.0" />
                <item
                    android:color="#FF0A2568"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
